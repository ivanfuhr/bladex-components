{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "ivanfuhr/std-components",
    "description": "Std Components — powerful components for Laravel Blade.",
    "keywords": [
        "laravel",
        "ivanfuhr",
        "std-components"
    ],
    "homepage": "https://github.com/ivanfuhr/std-components",
    "license": "MIT",
    "authors": [
        {
            "name": "Ivan F\u00fchr",
            "email": "dev.ivanfuhr@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/http": "^12.0||^13.0",
        "illuminate/support": "^12.0||^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.29",
        "laravel/pao": "^1.0",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.6",
        "pestphp/pest-plugin-laravel": "^4.1",
        "pestphp/pest-plugin-type-coverage": "^4.0",
        "phpstan/extension-installer": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "Ivanfuhr\\StdComponents\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ivanfuhr\\StdComponents\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "build": [
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "workbench:assets": [
            "cd workbench && npm ci && npm run build"
        ],
        "workbench:build": [
            "cd workbench && npm run build"
        ],
        "playbook": [
            "Composer\\Config::disableProcessTimeout",
            "@workbench:build",
            "@serve"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "vendor/bin/pint --parallel --blade",
            "npm run format"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test --blade",
            "npm run format:check"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse --memory-limit=512M"
        ],
        "test:types": [
            "@php -d memory_limit=512M vendor/bin/pest --type-coverage --min=100"
        ],
        "test:unit": [
            "vendor/bin/pest --parallel"
        ],
        "assets:build": [
            "npm run build"
        ],
        "test": [
            "@analyse",
            "@lint:check",
            "@test:types",
            "@test:unit"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ivanfuhr\\StdComponents\\StdComponentsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
