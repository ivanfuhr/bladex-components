{
    "$schema": "../schema/registry-item.json",
    "name": "breadcrumb",
    "type": "registry:ui",
    "title": "Breadcrumb",
    "description": "Accessible navigation trail with links, separators, current page, and ellipsis.",
    "registryDependencies": [
        "icon"
    ],
    "files": [
        {
            "path": "breadcrumb/ellipsis.blade.php",
            "type": "registry:ui",
            "target": "breadcrumb/ellipsis.blade.php",
            "content": "<span {{\n    $attributes->class([\n        'breadcrumb__ellipsis',\n        'flex size-9 items-center justify-center',\n    ])->merge([\n        'role' => 'presentation',\n        'aria-hidden' => 'true',\n        'data-breadcrumb-ellipsis' => true,\n    ])\n}}>\n    <span class=\"text-zinc-500 dark:text-zinc-400\">\u2026</span>\n    <span class=\"sr-only\">{{ __('stencil-ui::messages.breadcrumb_ellipsis') }}</span>\n</span>\n"
        },
        {
            "path": "breadcrumb/index.blade.php",
            "type": "registry:ui",
            "target": "breadcrumb/index.blade.php",
            "content": "<nav {{\n    $attributes->class([\n        'breadcrumb',\n    ])->merge([\n        'aria-label' => 'Breadcrumb',\n        'data-breadcrumb' => true,\n    ])\n}}>\n    {{ $slot }}\n</nav>\n"
        },
        {
            "path": "breadcrumb/item.blade.php",
            "type": "registry:ui",
            "target": "breadcrumb/item.blade.php",
            "content": "@props([\n    'href' => null,\n])\n\n<li {{\n    $attributes->class([\n        'breadcrumb__item',\n        'inline-flex items-center gap-1.5',\n    ])->merge([\n        'data-breadcrumb-item' => true,\n    ])\n}}>\n    @if (filled($href))\n        <x-ui::breadcrumb.link :href=\"$href\">{{ $slot }}</x-ui::breadcrumb.link>\n    @elseif (! $slot->isEmpty())\n        {{ $slot }}\n    @endif\n</li>\n"
        },
        {
            "path": "breadcrumb/link.blade.php",
            "type": "registry:ui",
            "target": "breadcrumb/link.blade.php",
            "content": "@props([\n    'href' => '#',\n])\n\n<a {{\n    $attributes->class([\n        'breadcrumb__link',\n        'transition-colors hover:text-zinc-950 dark:hover:text-zinc-50',\n    ])->merge([\n        'href' => $href,\n        'data-breadcrumb-link' => true,\n    ])\n}}>\n    {{ $slot }}\n</a>\n"
        },
        {
            "path": "breadcrumb/list.blade.php",
            "type": "registry:ui",
            "target": "breadcrumb/list.blade.php",
            "content": "<ol {{\n    $attributes->class([\n        'breadcrumb__list',\n        'flex flex-wrap items-center gap-1.5 text-sm text-zinc-500 break-words sm:gap-2.5 dark:text-zinc-400',\n    ])->merge([\n        'data-breadcrumb-list' => true,\n    ])\n}}>\n    {{ $slot }}\n</ol>\n"
        },
        {
            "path": "breadcrumb/page.blade.php",
            "type": "registry:ui",
            "target": "breadcrumb/page.blade.php",
            "content": "<span {{\n    $attributes->class([\n        'breadcrumb__page',\n        'font-normal text-zinc-950 dark:text-zinc-50',\n    ])->merge([\n        'role' => 'link',\n        'aria-disabled' => 'true',\n        'aria-current' => 'page',\n        'data-breadcrumb-page' => true,\n    ])\n}}>\n    {{ $slot }}\n</span>\n"
        },
        {
            "path": "breadcrumb/separator.blade.php",
            "type": "registry:ui",
            "target": "breadcrumb/separator.blade.php",
            "content": "@props([\n    'type' => 'chevron',\n])\n\n<li {{\n    $attributes->class([\n        'breadcrumb__separator',\n        'inline-flex items-center',\n    ])->merge([\n        'role' => 'presentation',\n        'aria-hidden' => 'true',\n        'data-breadcrumb-separator' => true,\n    ])\n}}>\n    @if (! $slot->isEmpty())\n        {{ $slot }}\n    @elseif ($type === 'slash')\n        <span class=\"text-zinc-400 dark:text-zinc-500\">/</span>\n    @else\n        <x-ui::icon name=\"chevron-right\" class=\"size-3.5 text-zinc-400 dark:text-zinc-500\" />\n    @endif\n</li>\n"
        }
    ],
    "iconDependencies": [
        "chevron-right"
    ]
}
