{
    "$schema": "../schema/registry-item.json",
    "name": "card",
    "type": "registry:ui",
    "title": "Card",
    "description": "Content container with header, title, description, content, action, and footer parts.",
    "registryDependencies": [],
    "files": [
        {
            "path": "card/action.blade.php",
            "type": "registry:ui",
            "target": "card/action.blade.php",
            "content": "<div {{\n    $attributes->class([\n        'card__action',\n        'col-start-2 row-span-2 row-start-1 self-start justify-self-end',\n    ])->merge([\n        'data-card-action' => true,\n    ])\n}}>\n    {{ $slot }}\n</div>\n"
        },
        {
            "path": "card/content.blade.php",
            "type": "registry:ui",
            "target": "card/content.blade.php",
            "content": "<div {{\n    $attributes->class([\n        'card__content',\n    ])->merge([\n        'data-card-content' => true,\n    ])\n}}>\n    {{ $slot }}\n</div>\n"
        },
        {
            "path": "card/description.blade.php",
            "type": "registry:ui",
            "target": "card/description.blade.php",
            "content": "<p {{\n    $attributes->class([\n        'card__description',\n        'text-sm text-zinc-500 dark:text-zinc-400',\n    ])->merge([\n        'data-card-description' => true,\n    ])\n}}>\n    {{ $slot }}\n</p>\n"
        },
        {
            "path": "card/footer.blade.php",
            "type": "registry:ui",
            "target": "card/footer.blade.php",
            "content": "<div {{\n    $attributes->class([\n        'card__footer',\n        'flex items-center gap-2',\n    ])->merge([\n        'data-card-footer' => true,\n    ])\n}}>\n    {{ $slot }}\n</div>\n"
        },
        {
            "path": "card/header.blade.php",
            "type": "registry:ui",
            "target": "card/header.blade.php",
            "content": "<div {{\n    $attributes->class([\n        'card__header',\n        'flex flex-col gap-1.5',\n    ])->merge([\n        'data-card-header' => true,\n    ])\n}}>\n    {{ $slot }}\n</div>\n"
        },
        {
            "path": "card/index.blade.php",
            "type": "registry:ui",
            "target": "card/index.blade.php",
            "content": "@props([\n    'size' => 'default',\n])\n\n@php\n    $padding = $size === 'sm' ? 'p-4' : 'p-6';\n@endphp\n\n<div {{\n    $attributes->class([\n        'card',\n        'flex flex-col gap-4 rounded-xl border border-zinc-200 bg-white text-zinc-950 shadow-sm',\n        'dark:border-zinc-800 dark:bg-zinc-950 dark:text-zinc-50',\n        $padding,\n    ])->merge([\n        'data-card' => true,\n        'data-size' => $size,\n    ])\n}}>\n    {{ $slot }}\n</div>\n"
        },
        {
            "path": "card/title.blade.php",
            "type": "registry:ui",
            "target": "card/title.blade.php",
            "content": "@props([\n    'level' => 3,\n])\n\n@php\n    $level = max(1, min(6, (int) $level));\n@endphp\n\n<h{{ $level }}\n    {{\n        $attributes->class([\n            'card__title',\n            'text-base font-semibold leading-none tracking-tight',\n        ])->merge([\n            'data-card-title' => true,\n        ])\n    }}\n>\n    {{ $slot }}\n</h{{ $level }}>\n"
        }
    ]
}
